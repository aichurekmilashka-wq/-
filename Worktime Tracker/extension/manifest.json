{
  "manifest_version": 3,
  "name": "Worktime — активность браузера",
  "version": "1.0.0",
  "description": "Учёт активной вкладки и простоя только во время запущенной рабочей задачи.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "idle", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Worktime"},
  "incognito": "not_allowed"
}
